---
import type { Route } from "@src/types";

type Props = {
  routes: Route[];
};

const { routes } = Astro.props;
---

<nav>
  <ul>
    {
      routes.map((route, index) => (
        <li>
          {index > 0 && (
            <span class="nav-divider" aria-hidden="true">
              /
            </span>
          )}
          <a href={route.url}>{route.name}</a>
        </li>
      ))
    }
  </ul>
</nav>
