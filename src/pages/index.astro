---
import { Picture } from "astro:assets";
import kenImage from "@src/assets/ken-ufo.jpg";
import Layout from "@src/layouts/Layout.astro";
const pageTitle = "";
---

<Layout pageTitle={pageTitle}>
  <p>Welcome! I'm Ken.</p>
  <Picture
    src={kenImage}
    alt="Ken"
    style={{
      width: "calc(100% + 2rem)",
      height: "auto",
      marginTop: "1rem",
      marginLeft: "-1rem",
      marginRight: "-1rem",
    }}
  />
</Layout>
