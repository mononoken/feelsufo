---
import { Picture } from "astro:assets";
import kenImage from "@src/assets/ken-ufo.jpg";
import Layout from "@src/layouts/Layout.astro";
const pageTitle = "";
---

<Layout pageTitle={pageTitle}>
  <p>
    Welcome! I'm Ken. I'm a programmer and avid walker/hiker. I work at <a
      href="https://www.nextglass.co"
      target="_blank"
      rel="noopener noreferrer">Next Glass</a
    > building projects like <a
      href="https://www.nextglass.co/untappd-for-business/"
      target="_blank"
      rel="noopener noreferrer">Untappd for Business</a
    >
    and <a
      href="https://www.nextglass.co/oznr/"
      target="_blank"
      rel="noopener noreferrer">oznr</a
    >. You may have seen our menus at your local breweries and bars.
  </p>
  <p>
    You can find <a href="/projects">other projects</a> I've worked on and
    <a
      href="https://www.github.com/mononoken/"
      target="_blank"
      rel="noopener noreferrer"
    >
      my GitHub</a
    >. I was a scholar at RubyConf 2024 and gave a <a href="/talks"
      >lightning talk</a
    > about securing a Ruby for Good application with policy-based role authorization.
  </p>
  <Picture
    src={kenImage}
    alt="Ken"
    style={{
      width: "calc(100% + 2rem)",
      height: "auto",
      marginTop: "1rem",
      marginLeft: "-1rem",
      marginRight: "-1rem",
    }}
  />
</Layout>
